[Unit]
Description=Word of the Day: Merriam-Webster's word of the day on the HyperPixel
PartOf=pi3-app-wotd.target
After=pi3-launcher.service network-online.target
Wants=network-online.target

# Crash-looping? Give up and fall back to the menu rather than leave a dead screen
StartLimitIntervalSec=120
StartLimitBurst=5
OnFailure=pi3-home.service

[Service]
User=@USER@
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_KMSDRM_DEVICE_INDEX=0
# Every word seen, up to 60 days (owned by @USER@)
StateDirectory=pi3-touch-wotd
ExecStart=/usr/bin/python3 /opt/pi3-touch/apps/wotd/wotd_display.py
Restart=always
RestartSec=5
