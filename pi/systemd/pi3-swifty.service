[Unit]
Description=Swifty: Taylor Swift games on the HyperPixel
PartOf=pi3-app-swifty.target
After=pi3-launcher.service

# Crash-looping? Give up and fall back to the menu rather than leave a dead screen
StartLimitIntervalSec=120
StartLimitBurst=5
OnFailure=pi3-home.service

[Service]
User=@USER@
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_KMSDRM_DEVICE_INDEX=0
# Games in progress, results and streaks (owned by @USER@)
StateDirectory=pi3-touch-swifty
ExecStart=/usr/bin/python3 /opt/pi3-touch/apps/swifty/swifty_display.py
Restart=always
RestartSec=5
