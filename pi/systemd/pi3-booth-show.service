[Unit]
Description=Booth Display: slides full screen on HDMI
PartOf=pi3-app-booth-display.target
After=pi3-launcher.service

# Crash-looping? Give up and fall back to the menu rather than leave a dead screen
StartLimitIntervalSec=120
StartLimitBurst=5
OnFailure=pi3-home.service

[Service]
# mpv exits 4 when stopped/restarted - that's normal, not a crash
SuccessExitStatus=4
User=@USER@
ExecStart=/opt/pi3-touch/apps/booth-display/showloop
Restart=always
RestartSec=3
TimeoutStopSec=5
